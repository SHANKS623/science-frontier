name: Science Frontier weekly digest
on:
  schedule:
    # UTC Mon/Wed 02:17 = Beijing Mon/Wed 10:17; Wednesday retries Monday failures
    - cron: '17 2 * * 1,3'
  workflow_dispatch:
permissions:
  contents: write
concurrency:
  group: science-frontier-update
  cancel-in-progress: false
jobs:
  update:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-python@v5
        with:
          python-version: '3.12'
          cache: 'pip'
      - run: python -m pip install -r requirements.txt
      - name: Fetch last week's papers and optionally draft briefs
        env:
          OPENAI_API_KEY: ${{ secrets.OPENAI_API_KEY }}
          OPENAI_MODEL: gpt-4.1-mini
        run: python update.py
      - name: Commit new weekly issue
        run: |
          git config user.name "science-frontier-bot"
          git config user.email "github-actions[bot]@users.noreply.github.com"
          git add data/
          if ! git diff --cached --quiet; then
            git commit -m "Update scientific frontiers weekly digest"
            git push
          fi
